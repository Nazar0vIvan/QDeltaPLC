olor=#202936;" vertex="1" parent="1"><mxGeometry x="750" y="412" width="60" height="6" as="geometry"/></mxCell><mxCell id="v22" value="TR_Request: PRO_ACT AND PGNO_REQ&#xa;AND JobPgno &lt;&gt; 0" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontFamily=Consolas;fontColor=#202936;" vertex="1" parent="1"><mxGeometry x="820" y="392" width="360" height="46" as="geometry"/></mxCell><mxCell id="e23" value="" style="endArrow=block;endFill=1;html=0;rounded=0;strokeWidth=2;strokeColor=#202936;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="418" as="sourcePoint"/><mxPoint x="780" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v24" value="ST_SELECT&#xa;PGNO = JobPgno - 1&#xa;EXT_START for T &gt;= 0.1 s" style="rounded=0;whiteSpace=wrap;html=0;strokeColor=#202936;strokeWidth=2;fillColor=#FFFFFF;fontSize=13;fontFamily=Consolas;fontColor=#202936;" vertex="1" parent="1"><mxGeometry x="640" y="470" width="280" height="64" as="geometry"/></mxCell><mxCell id="e25" value="" style="endArrow=none;html=0;rounded=0;strokeWidth=2;strokeColor=#202936;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780" y="534" as="sourcePoint"/><mxPoint x="780" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v26" value="" style="rounded=0;strokeColor=none;fillColor=#202936;" vertex="1" parent="1"><mxGeometry x="750" y="560" width="60" height="6" as="geometry"/></mxCell><mxCell id="v27" value="TR_Acked: APPL_RUN AND NOT PGNO_REQ&#xa;(result STARTED)" style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontFamily=Consolas;fontColor=#202936;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="360" height="46" as="geometry"/></mxCell><mxCell id="e28" value="" style="endArrow=block;endFill=1;html=0;rounded=0;strokeWidth=2;strokeColor=#202936;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><