GLOBAL DEFFCT POS READ_POS(FileHandle:IN,Ok:OUT)
   DECL INT FileHandle
   DECL BOOL Ok
   DECL STATE_T State
   DECL MODUS_T Mode
   DECL POS Target

   Mode=#SYNC
   Target={X 0.0,Y 0.0,Z 0.0,A 0.0,B 0.0,C 0.0,S -1,T -1}
   Ok=FALSE
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",FileHandle,"%f;%f;%f;%f;%f;%f;%d;%d",Target.X,Target.Y,Target.Z,Target.A,Target.B,Target.C,Target.S,Target.T)
   IF State.RET1==#DATA_OK THEN
      Ok=(Target.S>=0) AND (Target.S<=7) AND (Target.T>=0) AND (Target.T<=63)
   ENDIF
   RETURN Target
ENDFCT
