&ACCESS RVO
&REL 3
&PARAM DISKPATH = KRC:\R1\Program\RSI
DEF RSI_Probe_Calibration( )

DECL INT Step
DECL INT Last
DECL E6POS SearchStart

;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

$ADVANCE=0
$SEN_PINT[1]=0
$SEN_PINT[2]=0
$SEN_PINT[3]=0
IF RSI_RESET()<>RSIOK THEN
   RETURN
ENDIF

; PTP HOME at the operating-mode velocity of INIT_PTP_VEL, which also serves every later PTP
; (no inline form: its Vel would overwrite that velocity).
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,20 )
INIT_PTP_VEL ( )
$H_POS=XHOME
PTP  XHOME

   IF NOT READ_JOB() THEN
      RETURN
   ENDIF
   $BASE=$NULLFRAME
   $TOOL=ToolFrame
   $IPO_MODE=#BASE
   $ORI_TYPE=#CONSTANT
   $VEL.CP=TransferVelocity
   $ACC.CP=TransferAcceleration
   FOR Step=1 TO 6
      $ACC_AXIS[Step]=20
   ENDFOR
   IF RSI_CREATE("RSI_Probe_Calibration.rsi")<>RSIOK THEN
      RETURN
   ENDIF

   Last=StepCount
   IF (StepLimit>0) AND (StepLimit<StepCount) THEN
      Last=StepLimit
   ENDIF
   FOR Step=1 TO Last
      SWITCH StepKind[Step]
      CASE 1
         PTP StepTarget[Step]
      CASE 2
         LIN StepTarget[Step]
      CASE 3
         CIRC StepAux[Step],StepTarget[Step]
      CASE 4
         SearchStart=$POS_ACT
         IF $IN[8] THEN
            RETURN
         ENDIF
         IF NOT SEARCH(StepTouch[Step]) THEN
            LIN SearchStart
            RETURN
         ENDIF
      CASE 5
         PTP XHOME
      ENDSWITCH
   ENDFOR
   IF StepKind[Last]==4 THEN
      LIN SearchStart
   ENDIF
END

DEFFCT BOOL SEARCH(Touch:IN)
   DECL INT Touch
   DECL BOOL Touched
   
   $SEN_PINT[3]=Touch
   IF RSI_ON(#RELATIVE)<>RSIOK THEN
      RETURN FALSE
   ENDIF

   WAIT SEC 0.012
   $SEN_PINT[1]=1
   RSI_MOVECORR()
   Touched=$IN[8]
   $SEN_PINT[1]=0
   RETURN (RSI_OFF()==RSIOK) AND Touched
ENDFCT

DEFFCT BOOL READ_JOB()
   DECL STATE_T State
   DECL MODUS_T Mode
   DECL INT File
   DECL INT Version
   DECL INT Step
   DECL BOOL Ok

   ; Version 1 of /RoboCrapJobs/calibration_data.txt (RSI_Probe_Calibration_CONTRACT.md).
   Mode=#SYNC
   File=0
   Version=0
   StepCount=0
   IF NOT REMOUNT_SHARE() THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_fopen","/RoboCrapJobs/calibration_data.txt","r",File)
   IF State.RET1<>#DATA_OK THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d",Version)
   Ok=(State.RET1==#DATA_OK) AND (Version==1)
   ToolFrame=READ_FRAME(File,Ok)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferVelocity)
   Ok=Ok AND (State.RET1==#DATA_OK)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferAcceleration)
   Ok=Ok AND (State.RET1==#DATA_OK)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d",StepCount)
   Ok=Ok AND (State.RET1==#DATA_OK) AND (StepCount>=1) AND (StepCount<=600)
   Step=1
   WHILE Ok AND (Step<=StepCount)
      ; Reset first: values left from a previous job must not survive a partial conversion.
      StepKind[Step]=0
      StepTouch[Step]=0
      CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d;%d",StepKind[Step],StepTouch[Step])
      Ok=(State.RET1==#DATA_OK) AND (StepKind[Step]>=1) AND (StepKind[Step]<=5)
      IF Ok AND (StepKind[Step]==3) THEN
         StepAux[Step]=READ_POS(File,Ok)
      ENDIF
      IF Ok AND (StepKind[Step]<=3) THEN
         StepTarget[Step]=READ_POS(File,Ok)
      ENDIF
      Step=Step+1
   ENDWHILE
   CWRITE($FCT_CALL,State,Mode,"krl_fclose",File)
   RETURN Ok AND (State.RET1==#DATA_OK)
ENDFCT
