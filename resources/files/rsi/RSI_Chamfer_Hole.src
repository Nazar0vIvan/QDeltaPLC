&ACCESS RVP
&REL 1
DEF RSI_Chamfer_Hole()
   DECL BOOL Completed

   INI
   $ADVANCE=0
   $SEN_PINT[1]=0
   IF RSI_RESET()<>RSIOK THEN
      RETURN
   ENDIF

   PTP HOME  Vel= 100 % DEFAULT

   IF NOT READ_JOB() THEN
      RETURN
   ENDIF
   $BASE=$NULLFRAME
   $TOOL=ToolFrame
   $IPO_MODE=#BASE
   $ORI_TYPE=#VAR
   $VEL.CP=TransferVelocity
   $ACC.CP=TransferAcceleration
   IF RSI_CREATE("RSI_Chamfer_Hole.rsi")<>RSIOK THEN
      RETURN
   ENDIF

   PTP PsIn
   LIN LeadStart

   IF RSI_ON(#RELATIVE)<>RSIOK THEN
      RETURN
   ENDIF
   $SEN_PINT[1]=1
   RSI_MOVECORR()
   Completed=$SEN_PINT[2]==1
   $SEN_PINT[1]=0
   IF (RSI_OFF()<>RSIOK) OR (NOT Completed) THEN
      RETURN
   ENDIF

   LIN PsOut
   PTP HOME  Vel= 100 % DEFAULT
END

DEFFCT BOOL READ_JOB()
   DECL STATE_T State
   DECL MODUS_T Mode
   DECL INT File
   DECL INT Version
   DECL BOOL Ok

   Mode=#SYNC
   File=0
   Version=0
   IF NOT REMOUNT_SHARE() THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_fopen","/RoboCrapJobs/shared_data.txt","r",File)
   IF State.RET1<>#DATA_OK THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d",Version)
   Ok=(State.RET1==#DATA_OK) AND (Version==2)
   PsIn=READ_POS(File,Ok)
   LeadStart=READ_POS(File,Ok)
   LeadEnd=READ_POS(File,Ok)
   PsOut=PsIn
   PsOut.A=LeadEnd.A
   PsOut.B=LeadEnd.B
   PsOut.C=LeadEnd.C
   PsOut.S=-1
   PsOut.T=-1
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d;%d",PsOut.S,PsOut.T)
   Ok=Ok AND (State.RET1==#DATA_OK) AND (PsOut.S>=0) AND (PsOut.S<=7) AND (PsOut.T>=0) AND (PsOut.T<=63)
   ToolFrame=READ_FRAME(File,Ok)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferVelocity)
   Ok=Ok AND (State.RET1==#DATA_OK)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferAcceleration)
   Ok=Ok AND (State.RET1==#DATA_OK)
   CWRITE($FCT_CALL,State,Mode,"krl_fclose",File)
   RETURN Ok AND (State.RET1==#DATA_OK)
ENDFCT
