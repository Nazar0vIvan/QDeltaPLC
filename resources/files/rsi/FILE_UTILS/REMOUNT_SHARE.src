DEFFCT BOOL REMOUNT_SHARE()
   DECL STATE_T State
   DECL MODUS_T Mode

   Mode=#SYNC
   CWRITE($FCT_CALL,State,Mode,"krl_fclose_all",-99)
   IF State.RET1<>#DATA_OK THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_unmount","/RoboCrapJobs")
   IF (State.RET1<>#DATA_OK) AND (State.MSG_NO<>-2) THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_mount","/RoboCrapJobs","//192.168.2.100/RoboCrapJobs","KrcReader","04295B098DFC11F0CCF6838B721AD0EA99")
   RETURN State.RET1==#DATA_OK
ENDFCT
