&ACCESS RVP
&REL 1
DEF RSI_Hole()
   DECL STATE_T OpenState
   DECL STATE_T CloseState
   DECL STATE_T VelocityState
   DECL STATE_T AccelerationState
   DECL MODUS_T Mode
   DECL INT FileHandle
   DECL INT Ret
   DECL BOOL ReadPsOk
   DECL BOOL ReadStartOk
   DECL BOOL ReadEndOk
   DECL BOOL CloseOk
   DECL BOOL Completed
   DECL FRAME PsOut

   INI
   $ADVANCE=0
   Ret=RSI_RESET()
   $SEN_PINT[1]=0

   PTP HOME  Vel= 100 % DEFAULT

   $TOOL=TOOL_DATA[6]
   $LOAD=LOAD_DATA[6]
   $BASE=$NULLFRAME
   $IPO_MODE=#BASE
   $ORI_TYPE=#VAR
   Mode=#SYNC
   FileHandle=0
   ReadPsOk=FALSE
   ReadStartOk=FALSE
   ReadEndOk=FALSE

   ; Existing mount and READ_FRAME/CLOSE_FILES helpers.
   CWRITE($FCT_CALL,OpenState,Mode,"krl_fopen","/RoboCrapJobs/shared_data.txt","r",FileHandle)
   IF OpenState.RET1 <> #DATA_OK THEN
      CloseOk=CLOSE_FILES()
      RETURN
   ENDIF
   Ps=READ_FRAME(FileHandle,ReadPsOk)
   LeadStart=READ_FRAME(FileHandle,ReadStartOk)
   LeadEnd=READ_FRAME(FileHandle,ReadEndOk)
   TransferVelocity=0.0
   TransferAcceleration=0.0
   CWRITE($FCT_CALL,VelocityState,Mode,"krl_fscanf",FileHandle,"%f",TransferVelocity)
   CWRITE($FCT_CALL,AccelerationState,Mode,"krl_fscanf",FileHandle,"%f",TransferAcceleration)
   CWRITE($FCT_CALL,CloseState,Mode,"krl_fclose",FileHandle)
   CloseOk=CLOSE_FILES()
   IF (NOT (ReadPsOk AND ReadStartOk AND ReadEndOk AND CloseOk)) OR (CloseState.RET1 <> #DATA_OK) THEN
      RETURN
   ENDIF

   IF (VelocityState.RET1 <> #DATA_OK) OR (AccelerationState.RET1 <> #DATA_OK) THEN
      RETURN
   ENDIF
   IF (TransferVelocity <= 0.0) OR (TransferAcceleration <= 0.0) THEN
      RETURN
   ENDIF
   IF (TransferVelocity > $VEL_MA.CP) OR (TransferAcceleration > $ACC_MA.CP) THEN
      RETURN
   ENDIF

   Ret=RSI_CREATE("RSI_Hole.rsi",RsiContext,TRUE)
   IF Ret <> RSIOK THEN
      RETURN
   ENDIF

   PTP Ps
   $VEL.CP=TransferVelocity
   $ACC.CP=TransferAcceleration
   LIN LeadStart

   ; RSI executes the nominal lead-in, machining and lead-out.
   $SEN_PINT[2]=0
   Ret=RSI_ON(#RELATIVE,#IPO_FAST)
   IF Ret <> RSIOK THEN
      Ret=RSI_DELETE(RsiContext)
      RETURN
   ENDIF
   $SEN_PINT[1]=1
   RSI_MOVECORR(#RSIBRAKE)
   ; Read the result before Start=0 lets the PC reset Result to 0.
   Completed=($SEN_PINT[2]==1)
   $SEN_PINT[1]=0
   Ret=RSI_OFF()
   IF Ret <> RSIOK THEN
      RETURN
   ENDIF
   Ret=RSI_DELETE(RsiContext)
   IF (Ret <> RSIOK) OR (NOT Completed) THEN
      RETURN
   ENDIF

   ; Same Ps origin, with the clear lead-out attitude for the LIN transfer.

   PsOut=Ps
   PsOut.A=LeadEnd.A
   PsOut.B=LeadEnd.B
   PsOut.C=LeadEnd.C

   $VEL.CP=TransferVelocity
   $ACC.CP=TransferAcceleration
   LIN PsOut

   PTP HOME  Vel= 100 % DEFAULT
END
