{
  "main_qml_file": "src/application/qml/Main.qml",
  "qml_module_paths": [
    "qml",
    "src/application/qml",
    {
      "path": "qml/Modules/Components",
      "target_path": "Components"
    },
    {
      "path": "qml/Modules/Styles",
      "target_path": "Styles"
    }
  ],
  "ignored_directories": [
    "/libs/*",
    "/python/*",
    "/old_imp/*"
  ],
	"use_local_plugins": true
}