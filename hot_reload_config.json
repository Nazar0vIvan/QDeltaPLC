{
  "main_qml_file": "qml/Main.qml",

  "qml_module_paths": [
    { "path": "qml",                "target_path": "qdeltaplc_qml_module" },
    { "path": "modules/Styles",     "target_path": "Styles" },
    { "path": "modules/Components", "target_path": "Components" }
  ],

  "qml_plugin_paths": [
    {
      "path": "build/<YOUR-BUILD-DIR>/qml/qdeltaplc_qml_module",
      "target_path": "qdeltaplc_qml_module",
      "compiler": "mingw_64",
      "qt_version": "6.8.3"
    },
    {
      "path": "build/<YOUR-BUILD-DIR>/qml/Styles",
      "target_path": "Styles",
      "compiler": "mingw_64",
      "qt_version": "6.8.3"
    },
    {
      "path": "build/<YOUR-BUILD-DIR>/qml/Components",
      "target_path": "Components",
      "compiler": "mingw_64",
      "qt_version": "6.8.3"
    }
  ],

  "use_local_plugins": true
}